# Local D1 decisions through the djev gateway (start it before clicker).
TYPESAFE_API_KEY=local-djev
TYPESAFE_BASE_URL=http://127.0.0.1:8765
TYPESAFE_DEFAULT_MODEL=d1-omni:600m-q8_0
ANTHROPIC_API_KEY=
CLICKER_EMAIL=
# Fara proposes focused-field text and reviews the final screenshot. Jev executes actions.
CLICKER_WRITER_API=fara
CLICKER_WRITER_BASE_URL=http://127.0.0.1:11434/v1
CLICKER_WRITER_MODEL=fara1p5-4b-q6k-16k
CLICKER_ANSWER_MODEL=fara1p5-4b-q6k-16k
CLICKER_WRITER_VISION=true

# Use fara1p5-4b-q6k-8k for either role when a smaller context is preferred.
# Other writer endpoints remain configurable: Anthropic, or OpenAI-compatible with
# CLICKER_WRITER_API=openai. For those providers set CLICKER_WRITER_API and its endpoint/model.
